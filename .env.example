# Copy to .env and fill in real values. .env is gitignored.
# Required by the admin seed scripts in scripts/.

# ── Twilio (scripts/seedTwilioConfig.js) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Gmail SMTP (scripts/seedEmailConfig.js) ──────────────────────────────────
GMAIL_FROM_EMAIL=you@gmail.com
GMAIL_FROM_NAME=Your Name - Company LLC
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_REPLY_TO=reply@gmail.com
GMAIL_CC=cc1@example.com,cc2@example.com
